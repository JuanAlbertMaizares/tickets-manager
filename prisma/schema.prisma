// Fuente de los modelos usados.
// 1- configuracion

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}


// 2- MODELOS
// 2- Modelos

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ticketsCreated  Ticket[]  @relation("CustomerTickets")
  ticketsAssigned Ticket[]  @relation("AgentTickets")
  comments        Comment[]
  auditLogs       AuditLog[]
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  closedAt    DateTime?

  customerId String
  customer   User   @relation("CustomerTickets", fields: [customerId], references: [id])

  assigneeId String?
  assignee   User?   @relation("AgentTickets", fields: [assigneeId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  comments  Comment[]
  tags      TicketTag[]
  auditLogs AuditLog[]
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  tickets Ticket[]
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  tickets TicketTag[]
}

model TicketTag {
  ticketId String
  tagId    String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  metadata  String?
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])
}
